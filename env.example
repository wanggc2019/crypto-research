# ==================== Telegram 推送 ====================
# 共享 Bot（crypto-news / crypto-price / crypto-onchain 等）：@BotFather 拿 token，chat_id 先 /start 一次
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# 可选：crypto-jobs 独立 Bot（如 独立 Bot（.env 配置））发报告；不填则回退上面的共享 Bot
# 也兼容TELEGRAM_JOBS_BOT_TOKEN / TELEGRAM_JOBS_CHAT_ID（脚本自动识别）
TELEGRAM_JOBS_BOT_TOKEN=
TELEGRAM_JOBS_CHAT_ID=

# 可选：crypto-knowledge 独立 Bot（独立 Bot（.env 配置））发每日学习内容；不填则回退共享 Bot
# 填法：@BotFather /newbot 创建 → 自己的账号给新 Bot 发 /start → 填 token 与 chat_id（可与共享 Bot 同一个）
# 也兼容 TELEGRAM_LEARNING_* / 独立 Bot（.env 配置）_* 命名（脚本自动识别）
# 验证：./crypto-knowledge/scripts/run.sh --whoami 应显示 独立 Bot（.env 配置）
TELEGRAM_KNOWLEDGE_BOT_TOKEN=
TELEGRAM_KNOWLEDGE_CHAT_ID=

# crypto-onchain 专用 Bot（独立 Bot（.env 配置））：链上告警与每日摘要
# 未填则回退共享 Bot（TELEGRAM_BOT_TOKEN / TELEGRAM_CHAT_ID）
TELEGRAM_ONCHAIN_BOT_TOKEN=
TELEGRAM_ONCHAIN_CHAT_ID=

# ==================== 可选 API key（不填 = 对应功能关闭） ====================
# r.jina.ai 免费 key：X/网页抓取限速 20→500 RPM（crypto-x-kol 默认匿名 20 RPM 即可，不必填）
JINA_API_KEY=
# DeepSeek：crypto-x-kol 中文翻译 + 一句话总结（没有则自动回退 ~/.dsh/.credentials.yaml）
DEEPSEEK_API_KEY=
# CoinMarketCap 免费 key（crypto-price 默认不启用；启用需改 config/app.yaml 的 sources.cmc）
CMC_API_KEY=
# Etherscan V2 免费 key：当前 walletflow 走公共 RPC，不需要它；保留为未来 BSC/备用源。
# 申请：https://etherscan.io/apis ；只读、无需钱包（免费档 3 calls/s、10 万次/日）
ETHERSCAN_API_KEY=
