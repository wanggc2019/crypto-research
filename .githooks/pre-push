#!/usr/bin/env bash
# pre-push 守卫：
#   1) 禁止直接 push main（必须走分支 + PR）；紧急放行：ALLOW_MAIN_PUSH=1 git push ...
#   2) 其它分支 push 前跑离线质量门 make gate，失败则阻止 push。
# 安装：make hooks（core.hooksPath=.githooks）
set -euo pipefail
cd "$(git rev-parse --show-toplevel)"

protected_ref="refs/heads/main"
if [ "${ALLOW_MAIN_PUSH:-}" != "1" ]; then
  blocked=0
  while read -r local_ref local_sha remote_ref remote_sha; do
    [ -n "${remote_ref:-}" ] || continue
    if [ "$remote_ref" = "$protected_ref" ]; then
      echo "[pre-push] ❌ 禁止直接 push main（local_ref=$local_ref）。" >&2
      echo "[pre-push]    请走：分支 → commit → push → gh pr create → CI 绿 → squash merge。" >&2
      echo "[pre-push]    紧急放行（慎用）：ALLOW_MAIN_PUSH=1 git push ..." >&2
      blocked=1
    fi
  done
  [ "$blocked" = "0" ] || exit 1
fi

echo "[pre-push] 运行质量门 make gate ..."
exec make gate
