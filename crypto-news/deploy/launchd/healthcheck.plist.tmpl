<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>__LABEL__</string>
  <key>ProgramArguments</key>
  <array>
    <string>__PYTHON__</string>
    <string>__REPO_DIR__/tools/healthcheck.py</string>
    <string>--module</string>
    <string>__MODULE__</string>
    <string>--notify</string>
    <string>--fix</string>
    <string>--agent</string>
  </array>
  <key>WorkingDirectory</key>
  <string>__MODULE_DIR__</string>
  <key>StartInterval</key>
  <integer>__INTERVAL__</integer>
  <key>RunAtLoad</key>
  <true/>
  <key>StandardOutPath</key>
  <string>__LOG_DIR__/healthcheck.out.log</string>
  <key>StandardErrorPath</key>
  <string>__LOG_DIR__/healthcheck.err.log</string>
  <key>EnvironmentVariables</key>
  <dict>
    <key>CRYPTO_JOB_LABEL</key>
    <string>__LABEL__</string>
    <key>PATH</key>
    <string>/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
    <key>LANG</key>
    <string>zh_CN.UTF-8</string>
  </dict>
</dict>
</plist>
