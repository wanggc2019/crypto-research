<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>__LABEL__</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>__MODULE_DIR__/scripts/alert.sh</string>
  </array>
  <key>WorkingDirectory</key>
  <string>__MODULE_DIR__</string>
  <!-- 事件速报：每 2 小时轻量抓取一次，发现新目标岗位立即推 Telegram；
       与日报/周报任务是独立任务（报告任务仍每天 18:00 / 周日 10:00）。 -->
  <key>StartInterval</key>
  <integer>7200</integer>
  <key>RunAtLoad</key>
  <false/>
  <key>StandardOutPath</key>
  <string>__LOG_DIR__/launchd.out.log</string>
  <key>StandardErrorPath</key>
  <string>__LOG_DIR__/launchd.err.log</string>
  <key>EnvironmentVariables</key>
  <dict>
    <key>CRYPTO_JOB_LABEL</key>
    <string>__LABEL__</string>
    <key>PATH</key>
    <string>/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
    <key>LANG</key>
    <string>zh_CN.UTF-8</string>
  </dict>
</dict>
</plist>
