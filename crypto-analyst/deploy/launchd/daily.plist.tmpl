<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>__LABEL__</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>__MODULE_DIR__/scripts/run.sh</string>
    <string>--notify</string>
  </array>
  <key>WorkingDirectory</key>
  <string>__MODULE_DIR__</string>
  <key>EnvironmentVariables</key>
  <dict>
    <key>CRYPTO_JOB_LABEL</key>
    <string>__LABEL__</string>
  </dict>
  <!-- 每日 10:00（本地时区）生成并推送每日行情简报；RunAtLoad=false，安装时不立即跑 -->
  <key>StartCalendarInterval</key>
  <dict>
    <key>Hour</key>
    <integer>10</integer>
    <key>Minute</key>
    <integer>0</integer>
  </dict>
  <key>RunAtLoad</key>
  <false/>
  <key>StandardOutPath</key>
  <string>__LOG_DIR__/launchd.out.log</string>
  <key>StandardErrorPath</key>
  <string>__LOG_DIR__/launchd.err.log</string>
</dict>
</plist>
